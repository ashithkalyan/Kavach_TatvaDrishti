# KAVACH — Karnataka AI Voice & Crime Hub
# Copy this file to .env and adjust as needed. Every variable below is
# something the code actually reads — nothing here is a leftover from
# an earlier architecture (the old .env.example referenced a Gemini key
# and a Google Translate key that nothing in this codebase uses).

# ─── Database ───────────────────────────────────────────────────────
DB_PATH=kavach.db

# ─── Auth ───────────────────────────────────────────────────────────
SECRET_KEY=kavach-ksp-secret-2026-change-in-production
SESSION_LIFETIME_HOURS=12

# ─── Optional local LLM polishing (Ollama) ─────────────────────────
# Entirely optional — every feature works without this. If it's not
# running, KAVACH answers using its deterministic templates only.
# Setup: curl -fsSL https://ollama.com/install.sh | sh  &&  ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── App environment ────────────────────────────────────────────────
APP_ENV=development
